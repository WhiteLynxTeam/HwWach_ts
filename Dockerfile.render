FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
# RUN npm ci --only=production
RUN npm ci

# Copy source code
# COPY src/ ./src/
# COPY tsconfig*.json ./

# COPY . . делает жизнь проще: ничего не нужно держать в голове, всё попадает в образ.
# Позже, когда структура устаканится и ты захочешь более «чистый» и минимальный образ,
#  можно вернуть более точечные COPY src, COPY tsconfig*.json, COPY nest-cli.json и т.п.
COPY . .

# Build the application
RUN npm run build

# Create non-root user for security
# RUN addgroup -g 1001 -S nodejs
# RUN adduser -S nextjs -u 1001

# Change ownership of the app directory to the non-root user
# RUN chown -R nextjs:nodejs /app

RUN addgroup -g 1001 -S nodejs \
  && adduser -S nextjs -u 1001 \
  && chown -R nextjs:nodejs /app

USER nextjs

# Expose port (Render sets the PORT environment variable automatically)
EXPOSE $PORT

# Start the application
# CMD ["node", "dist/main.js"]
CMD ["npm", "run", "start:prod"]